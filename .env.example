# Configuración de la app (copia este archivo como .env y llena los valores).
# El archivo .env NUNCA se sube al repositorio: contiene la llave secreta de Supabase.
PORT=3000
FARMACIA_DB=./farmacia.db

# Supabase central (Project Settings → API Keys)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave secreta (sb_secret_…). Solo va en las computadoras de las farmacias, nunca en celulares ni en GitHub.
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZA_POR_LA_LLAVE_SECRETA

# Opcional: dirección de la app del celular publicada en Cloudflare Pages (ver docs/celular.md).
# También se puede escribir en Administración → Datos del ticket.
# MOVIL_URL=https://farmacia-inventario.pages.dev
